# Environment Variables Template
# Copy this file to .env.local and fill in your actual credentials.
# Do NOT commit secrets to public repositories.

# Server-Only Google OAuth Credentials for Gmail API
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5173/api/auth/google/callback
GOOGLE_REFRESH_TOKEN=

# Firebase Client Credentials
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# ──────────────────────────────────────────────
# Razorpay Payment Gateway (Server-Side Only)
# Get these from: https://dashboard.razorpay.com/app/keys
# ──────────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# ──────────────────────────────────────────────
# Firebase Admin SDK (Server-Side Only)
# Used by /api/razorpay/verify-payment to write to Firestore securely.
# Option A: Paste the full service account JSON (escape newlines as \n) — most reliable
# Option B: Leave blank if running in a Firebase-hosted environment (uses ADC)
# Generate from: Firebase Console → Project Settings → Service Accounts → Generate new private key
# ──────────────────────────────────────────────
FIREBASE_SERVICE_ACCOUNT_JSON=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=yodha-2
